# Copy to .env.local. All values are public (publishable) — no secrets here.

# Jorna backend (FastAPI on Railway). Point at a local backend for dev if you like.
NEXT_PUBLIC_API_BASE_URL=https://desiconnect-production.up.railway.app

# This app has no escrow/Stripe checkout flow — contract deposits are
# self-attested and paid off-platform. Baked in at build time (static
# export), so it belongs here, not just in CI. See lib/flags.ts.
NEXT_PUBLIC_ESCROW_ENABLED=false

# Supabase — only needed for Google OAuth (a later phase). The anon key is publishable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry (client-side error monitoring). Blank = disabled (see web/src/lib/sentry.ts).
NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production   # defaults to NODE_ENV if unset
