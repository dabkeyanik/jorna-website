{
  // Cloudflare Pages project serving ./public (the marketing page at / and the
  // exported web app under /app).
  //
  // Deploy with `npm run deploy` (build + `wrangler pages deploy` + verify).
  // This project name must stay distinct from jorna-website's "jorna-events"
  // Pages project — this repo was forked from jorna-website, and its CI
  // deploy job (.github/workflows/ci.yml) would silently overwrite the real
  // production site if the two ever pointed at the same Cloudflare project.
  "name": "jorna-vendor",
  "pages_build_output_dir": "./public"
}
