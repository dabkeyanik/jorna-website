node_modules/

# Next.js build artifacts for the web app
web/.next/
web/out/
web/next-env.d.ts

# Generated: the web app's static export, copied here at build time and served
# by the Worker at /app. Built by `npm run build`, so it isn't committed.
public/app/

# Local env (values are public, but keep them out of git by convention)
.env
.env.local
web/.env
web/.env.local

.wrangler/
.DS_Store

# Incremental typecheck cache from `tsc --noEmit`
web/tsconfig.tsbuildinfo

# Figma Make exports. The design lives in Figma; these are 1.4 MB snapshots of
# it, and what mattered from them is already ported into web/src (see the
# marketing home and the vendor dashboard). Keep them locally to re-read — the
# code inside is a git repo in packfiles, so `unzip` then rebuild from
# make_repos/ — but they don't belong in this history.
*.make
